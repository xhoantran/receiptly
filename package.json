{
  "name": "receiptly",
  "version": "0.0.1",
  "description": "Open-source library for fetching SKU-level receipts from merchants. Plaid stops at the transaction; receiptly goes to the item.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "web": "pnpm --filter receiptly-web dev",
    "receiptly": "pnpm --filter @receiptly/core receiptly",
    "db:generate": "pnpm --filter @receiptly/core db:generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
