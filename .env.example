# Postgres connection string. Self-host points this at the local Docker
# Postgres (infra/compose/docker-compose.yml); hosted points it at a managed DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/receiptly

# At-rest encryption key for sensitive secrets (Plaid tokens, merchant sessions).
# 32 random bytes, base64-encoded. Generate with:  openssl rand -base64 32
RECEIPTLY_ENCRYPTION_KEY=

# Better Auth session/token signing secret. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Plaid — get from https://dashboard.plaid.com/developers/keys
# Plaid sunsetted Development. Use `sandbox` (fake data, free) or
# `production` (real banks; first 200 API calls free under "Limited Production").
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Anthropic — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

PORT=3000
